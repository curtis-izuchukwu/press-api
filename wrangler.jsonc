{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightdeck-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "FLIGHTDECK_CACHE",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flightdeck-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}